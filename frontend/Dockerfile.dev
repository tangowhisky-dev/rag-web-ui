# syntax=docker/dockerfile:1
FROM node:24-alpine

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@11

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# Copy package files
COPY package.json ./
COPY pnpm-lock.yaml* ./
COPY pnpm-workspace.yaml* ./

# Cache mount for pnpm content-addressable store
RUN --mount=type=cache,target=/pnpm/store \
    pnpm config set fetch-timeout 600000 && \
    pnpm config set fetch-retries 5 && \
    pnpm config set fetch-retry-mintimeout 60000 && \
    pnpm config set fetch-retry-maxtimeout 300000 && \
    pnpm install --force

# Copy the rest of the application
COPY . .

# Expose the port
EXPOSE 3000

# Start the development server, attention: this is for development, not for production
CMD ["pnpm", "dev"]
