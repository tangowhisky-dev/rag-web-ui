# OpenAI-compatible API (LM Studio, OpenAI, etc.)
OPENAI_API_KEY=***
OPENAI_API_BASE=https://api.openai.com/v1

# Response generation model (used for RAG answers)
OPENAI_MODEL=qwen/qwen3.5-9b

# Total context window size of OPENAI_MODEL in tokens.
# 25% is reserved for injected chat-file content (~32k tokens at default).
OPENAI_MODEL_CONTEXT_SIZE=131072

# Query-rewriting and summarisation model — smaller/faster is fine.
# Omit or leave empty to reuse OPENAI_MODEL.
QUERY_MODEL=qwen/qwen3.5-4b

# Reasoning / thinking model for the "Thinking" answering mode.
# Should be a CoT/reasoning-capable model (e.g. qwq-32b, deepseek-r1, o3-mini).
# Falls back to OPENAI_MODEL when unset.
REASONING_MODEL=

# Vision model for markitdown-ocr (OCR of scanned PDFs / embedded images).
# Must be a multimodal model.  Leave empty to disable OCR.
VISION_MODEL=qwen/qwen3.5-4b
# OPENAI_VISION_API_BASE=  # override base URL for the vision model; defaults to OPENAI_API_BASE

# Embeddings model
DENSE_EMBEDDINGS_MODEL=qwen/qwen3-embedding-0.6b

# Optional alternative LLM for graph extraction (Neo4j + GraphRAG).
# NOTE: the neo4j-graphrag extraction prompt is large (~800 tokens overhead).
# With CHUNK_SIZE=1500 (~375 tokens), total prompt is ~1200 tokens minimum.
# Set the model's context window to at least 16k in LM Studio to avoid
# "Context size has been exceeded" errors on longer chunks.
GRAPHRAG_LLM=qwen/qwen3.5-4b

# File storage
UPLOAD_DIR=/app/uploads

# Retrieval
RETRIEVAL_TOP_K=10
# Minimum RRF score threshold — chunks below this are dropped before the LLM sees them.
# RRF scores for a 3-leg setup (K=60) range roughly 0.003–0.02.
# Increase to 0.007 or 0.008 if irrelevant chunks from unrelated documents appear.
# Set to 0.0 to disable.
RETRIEVAL_MIN_RRF_SCORE=0.005

# Cross-encoder reranker — re-scores RRF candidates with ms-marco MiniLM-L-12
# More accurate than RRF threshold alone for cross-document disambiguation.
# Set RERANKER_ENABLED=false to disable (falls back to RRF order).
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
RERANKER_CACHE_DIR=/app/assets/reranker
# Min cross-encoder logit to pass. Scores are bimodal: relevant chunks cluster
# 1–10, irrelevant cluster -5 to -11. -5.0 keeps borderline chunks; raise to
# 0.0 to pass only clearly relevant chunks.
RERANKER_SCORE_THRESHOLD=-5.0

# Chunking
# WARNING: changing these values after documents have been ingested creates
# inconsistent chunk sizes across the knowledge base. If you change them,
# delete and re-upload all existing documents to re-index with the new settings.
#
# CHUNK_SIZE: target chunk size in characters. Keep <= 1800 chars when using
# SPLADE (prithivida/Splade_PP_en_v1) — BERT's 512-token limit means longer
# chunks are silently truncated in the sparse leg (~4 chars/token for English).
CHUNK_SIZE=1500
# OVERLAP_PERCENTAGE: fraction of chunk_size repeated at the start of the next
# chunk (0.0–1.0). 0.20 = 20% overlap = 300 chars at chunk_size=1500.
OVERLAP_PERCENTAGE=0.20

# Hybrid search weights (dense=Qdrant cosine, qdrant_sparse=SPLADE, exact=MySQL FTS)
HYBRID_DENSE_WEIGHT=0.5
HYBRID_QDRANT_SPARSE_WEIGHT=0.3
HYBRID_EXACT_WEIGHT=0.2
# Per-leg enable/disable (ingestion always indexes all three regardless)
RETRIEVAL_DENSE_ENABLED=true
RETRIEVAL_QDRANT_SPARSE_ENABLED=true
RETRIEVAL_EXACT_ENABLED=true

# Neo4j / GraphRAG
# WARNING: NEO4J_URI uses service name 'neo4j' — only works inside Docker network.
# For local dev without Docker, use bolt://localhost:7687
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ragwebui_neo4j

# Set false to skip graph extraction during document ingestion.
# Documents will still be fully searchable via the 3-leg hybrid pipeline.
GRAPHRAG_ENABLED=true

# ReLiK service — entity/relationship extraction (NER+RE).
# ReLiK requires 12-16 GB RAM to load Wikipedia-scale indexes. If your host
# cannot spare that, leave COMPOSE_PROFILES commented out and use GRAPHRAG_LLM
# as a fallback, or set GRAPHRAG_ENABLED=false to skip graph extraction.
#
# Set COMPOSE_PROFILES=relik to start the ReLiK container with the stack.
# Leave commented out (or empty) to skip the ReLiK container entirely.
# COMPOSE_PROFILES=relik

# ReLiK service internal URL (must match docker-compose service name).
RELIK_URL=http://relik:8000

# LLM-based entity/relationship extraction — fallback when ReLiK is not running.
# When set, uses neo4j-graphrag Pipeline + LLMEntityRelationExtractor with
# use_structured_output=True (JSON Schema-constrained — no free-form JSON drift).
# When unset, ReLiK is used. When both are unset, graph extraction is skipped.
# Uses OPENAI_API_BASE / OPENAI_API_KEY credentials.
# Examples:
#   GRAPHRAG_LLM=gpt-4o                 # OpenAI
#   GRAPHRAG_LLM=qwen/qwen3.5-4b       # local via LM Studio

# Retrieval: enable/disable graph leg independently of ingestion.
RETRIEVAL_GRAPH_ENABLED=true

# Number of relationship hops to traverse from seed nodes at query time (1-3 recommended).
GRAPHRAG_RETRIEVAL_HOPS=2

# Max chunks per document to extract entities from (rest still go to Qdrant/MySQL). Set to 0 for no limit.
GRAPHRAG_MAX_CHUNKS=0

# Context window budget for the graph extraction LLM (characters).
# Consecutive chunks are batched up to this limit (50% used for text; 50% headroom
# for neo4j-graphrag system prompt + JSON schema + output tokens).
# Rule of thumb: 1 token ≈ 3-4 chars.
#   Qwen-3.5-4B (8K ctx)  → 24000
#   4K token model        → 12000
#   8K token model        → 24000
NEO4J_LLM_CONTEXT=24000

# RRF weight for the graph retrieval leg (alongside dense=0.5, sparse=0.3, exact=0.2).

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Dense embedding dimension (must match DENSE_EMBEDDINGS_MODEL output)
DENSE_EMBEDDING_DIM=1024

# SPLADE sparse embedder (FastEmbed, CPU)
SPLADE_MODEL=prithivida/Splade_PP_en_v1
FASTEMBED_CACHE_DIR=./assets/fastembed

# MySQL
MYSQL_SERVER=db
MYSQL_PORT=3306
MYSQL_USER=ragwebui
MYSQL_PASSWORD=ragwebui
MYSQL_DATABASE=ragwebui

# JWT
SECRET_KEY=your-secret-key-here
TIMEOUT_SECONDS=30000

# Timezone
# All services run in UTC. Do not change this — timestamps are stored as UTC
# in the DB and the frontend converts to the user's local timezone automatically.
TZ=UTC

# ── M001: Adaptive Retrieval & Agentic Features ──────────────────────────────

# Query classifier — classifies queries as FACTUAL/ENTITY_CENTRIC/MULTI_PART/AMBIGUOUS
# and routes to the appropriate retrieval preset. Disable to use default hybrid search.
QUERY_CLASSIFIER_ENABLED=true

# Entity-aware retrieval — extracts entities from ENTITY_CENTRIC queries and
# applies a score boost to chunks that mention those entities.
ENTITY_AWARE_ENABLED=true
# Score boost applied to each chunk per matching entity mention (additive).
ENTITY_BOOST_FACTOR=0.1

# Retrieval config presets — per-query-type overrides for leg weights and top-k.
# JSON object keyed by query type. Leave blank to use global HYBRID_*_WEIGHT defaults.
# Example:
#   RETRIEVAL_CONFIG_PRESETS={"FACTUAL":{"dense_weight":0.5,"sparse_weight":0.3,"exact_weight":0.2},"ENTITY_CENTRIC":{"use_sparse":false,"use_exact":false,"dense_weight":0.6,"sparse_weight":0.2,"exact_weight":0.2},"MULTI_PART":{"use_exact":false,"dense_weight":0.5,"sparse_weight":0.5,"exact_weight":0.0},"AMBIGUOUS":{"top_k":15}}
# RETRIEVAL_CONFIG_PRESETS=

# Agentic tool calling — enables the pre-answer tool-calling loop in chat.
# The LLM may call search_documents, extract_entities, or summarize_chunks.
TOOL_CALLING_ENABLED=true
# Maximum tool-call iterations per chat turn (prevents runaway loops).
MAX_TOOL_ITERATIONS=5

# Synthesis mode — for MULTI_PART queries with synthesis keywords (summarize,
# compare, themes, etc.) the LLM uses synthesize_documents for broad coverage
# and produces a structured Markdown report with citations.
SYNTHESIS_MODE_ENABLED=true
