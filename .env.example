# ═══════════════════════════════════════════════════════════════════════════
# .env.example — Deployment & infrastructure configuration only.
#
# All LLM, retrieval, agent, memory, and ingestion settings are managed via
# the settings table (Super Admin UI for app defaults, Admin UI for org
# overrides). They are NOT set in .env.
#
# The registry provides sensible defaults that work out of the box.
# Super Admins should configure real values via the UI after first boot.
#
# Settings managed via UI (NOT in .env):
#   OPENAI_API_KEY, OPENAI_API_BASE, OPENAI_MODEL, OPENAI_MODEL_CONTEXT_SIZE
#   QUERY_MODEL, QUERY_API_KEY, QUERY_API_BASE
#   REASONING_MODEL, REASONING_API_KEY, REASONING_API_BASE
#   VISION_MODEL, VISION_API_KEY, OPENAI_VISION_API_BASE  (super_admin only)
#   GRAPHRAG_LLM, GRAPHRAG_API_KEY, GRAPHRAG_API_BASE      (super_admin only)
#   DENSE_EMBEDDINGS_MODEL, DENSE_EMBEDDING_DIM
#   EMBEDDING_API_KEY, EMBEDDING_API_BASE
#   MEMORY_EMBEDDING_MODEL, MEMORY_ENABLED
#   RETRIEVAL_TOP_K, DENSE_MIN_SCORE, SPARSE_MIN_SCORE, EXACT_MIN_SCORE
#   HYBRID_DENSE_WEIGHT, HYBRID_SPARSE_WEIGHT, HYBRID_EXACT_WEIGHT
#   RETRIEVAL_DENSE_ENABLED, RETRIEVAL_SPARSE_ENABLED, RETRIEVAL_EXACT_ENABLED
#   RERANKER_ENABLED, RERANKER_SCORE_THRESHOLD
#   CHUNK_SIZE, OVERLAP_PERCENTAGE
#   GRAPHRAG_ENABLED, GRAPHRAG_MAX_CHUNKS, NEO4J_LLM_CONTEXT
#   RETRIEVAL_GRAPH_ENABLED, GRAPHRAG_RETRIEVAL_HOPS, GRAPHRAG_RETRIEVAL_LIMIT
#   ENTITY_AWARE_ENABLED, ENTITY_BOOST_FACTOR
#   ADAPTIVE_RETRIEVAL_ENABLED, ADAPTIVE_RETRIEVAL_THRESHOLD,
#   ADAPTIVE_RETRIEVAL_RERANKER_THRESHOLD
#   QUERY_CLASSIFIER_ENABLED, TOOL_CALLING_ENABLED, SYNTHESIS_MODE_ENABLED
#   TOOL_CALL_MODE, AGENT_MAX_ITERATIONS, AGENT_MAX_RETRIEVALS,
#   AGENT_MAX_CODE_EXEC, AGENT_MAX_REFLECTIONS, AGENT_REFLECT_EVERY,
#   AGENT_MAX_TOOL_RETRIES, AGENT_RETRY_BACKOFF_BASE,
#   AGENT_MAX_CLARIFICATIONS, AGENT_HISTORY_PAIRS, AGENT_MAX_WALL_SECONDS
#   HISTORICAL_MEMORY_ENABLED, HISTORICAL_MEMORY_TOP_K,
#   HISTORICAL_MEMORY_SCORE_THRESHOLD
#   CONTEXT_RESERVED_GENERATION, CONTEXT_TOOL_BUDGET, HIGHLIGHTS_TOKEN_CAP
#   CONTEXT_COMPACTION_TRIGGER_RATIO, COMPACTION_ENABLED,
#   COMPACTION_KEEP_RECENT, COMPACTION_SUMMARY_MAX_CHARS
#   ANSWER_QUALITY_GRADING_ENABLED, PROCESSING_TIMEOUT_SILENCE_S
#   WATCHER_ENABLED, WATCH_POLL_INTERVAL, SANDBOX_TIMEOUT_S
# ═══════════════════════════════════════════════════════════════════════════

# ── Feature flag ────────────────────────────────────────────────────────────

# ── Database (MySQL) ────────────────────────────────────────────────────────
MYSQL_SERVER=db
MYSQL_PORT=3306
MYSQL_USER=ragwebui
MYSQL_PASSWORD=ragwebui
MYSQL_DATABASE=ragwebui
# Root password for the MySQL container (admin tasks, health checks).
# Separate from MYSQL_PASSWORD which is the app user's password.
MYSQL_ROOT_PASSWORD=root

# ── JWT / Security ──────────────────────────────────────────────────────────
# REQUIRED — strong random value. The app will refuse to start with the
# default placeholder "your-secret-key-here". Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Set to true when serving over HTTPS so the auth cookie gets the Secure flag.
COOKIE_SECURE=false
# Comma-separated trusted proxy IPs for X-Forwarded-* header parsing.
# '*' trusts all proxies. Leave empty to use direct peer IP only.
TRUSTED_PROXIES=

# ── Redis Stack ─────────────────────────────────────────────────────────────
# LangGraph short-term (checkpointer) + long-term (store) memory.
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001

# ── Qdrant (vector store) ───────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ── Neo4j (graph store) ─────────────────────────────────────────────────────
# Uses service name 'neo4j' — only works inside Docker network.
# For local dev without Docker, use bolt://localhost:7687
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ragwebui_neo4j

# ── File storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
# Legacy fallback for per-org directory watch (defaults in Organisation model).
WATCH_DIR=/app/uploads

# ── Embedded models (not user-changeable at runtime) ────────────────────────
# SPLADE sparse embedder (FastEmbed / ONNX — CPU-optimised).
# Loaded once into a process-global ONNX session.
SPLADE_MODEL=prithivida/Splade_PP_en_v1
FASTEMBED_CACHE_DIR=/app/assets/fastembed

# Cross-encoder reranker model (ONNX — CPU-optimised).
# Loaded once into a process-global cross-encoder.
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-12-v2
RERANKER_CACHE_DIR=/app/assets/reranker

# ── Watcher (file change detection) ─────────────────────────────────────────
# Docker Desktop on macOS doesn't propagate inotify events — set to false
# to use PollingObserver instead.
WATCHER_USE_INOTIFY=false

# ── Logging / Timezone ──────────────────────────────────────────────────────
# Root logger level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Frontend debug logging (exposed to browser via NEXT_PUBLIC_*)
NEXT_PUBLIC_DEBUG=false
# All services run in UTC. Do not change this — timestamps are stored as UTC
# in the DB and the frontend converts to the user's local timezone.
TZ=UTC

# ── Initialisation seed (runs once on first startup) ────────────────────────
# Creates ROOT_ORG organisation and a superadmin user if no superadmin exists.
# Only needed on first run — subsequent startups skip seeding.
# These values are REQUIRED — the app will refuse to start without them.
ROOT_ORG=Root Organization
SUPERADMIN_USERNAME=super_admin
SUPERADMIN_PASSWORD=changeme
